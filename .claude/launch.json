{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
      "runtimeArgs": ["-m", "uvicorn", "legacydoc_api.main:get_app", "--factory", "--host", "127.0.0.1", "--port", "8000"],
      "port": 8000
    },
    {
      "name": "front",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--prefix", "Front/test/LegacyDocFront", "run", "dev", "--", "--port", "5173", "--strictPort"],
      "port": 5173
    }
  ]
}
