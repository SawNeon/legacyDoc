# ---------------------------------------------------------------- ambiente
ENVIRONMENT=development
LOG_LEVEL=INFO

# ------------------------------------------------------------ banco e fila
# A fila vive no proprio Postgres (SELECT ... FOR UPDATE SKIP LOCKED).
POSTGRES_PASSWORD=troque-esta-senha
DATABASE_URL=postgresql+asyncpg://legacydoc:troque-esta-senha@localhost:5432/legacydoc
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=5

# ------------------------------------------------------------------- auth
# Obrigatorio, minimo 32 caracteres. A aplicacao NAO sobe sem isto - e
# proposital: a v1 tinha um segredo padrao versionado no repositorio, o que
# permitia a qualquer pessoa forjar um token valido.
# Gere com: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440
MIN_PASSWORD_LENGTH=10

# -------------------------------------------------------------------- api
# Nunca use "*": a API trabalha com credenciais e curinga desativa a protecao
# de origem do navegador. A aplicacao rejeita "*" no startup.
# Em producao: https://app.legacydoc.com.br
ALLOWED_ORIGINS=http://localhost:5173
API_ROOT_PATH=

# Limite de requisicoes por IP dentro da aplicacao. O nginx ja limita na
# borda; este e o limite que acompanha a API mesmo sem proxy na frente.
RATE_LIMIT_ENABLED=true

# Ligue APENAS se houver um proxy reverso seu na frente reescrevendo o
# X-Forwarded-For (o nginx de infra/nginx-legacydoc.conf faz isso). Ligado sem
# proxy, qualquer chamador forja um endereco e zera o proprio limite.
# Em producao: true
TRUST_PROXY_HEADERS=false

# Porta do host onde a API da v2 escuta (somente loopback; o nginx faz o
# proxy). Padrao 8001 para nao colidir com a v1, que usa a 8000.
API_PORT=8001

# ------------------------------------------------------------------ e-mail
# `console` escreve o e-mail no log e NAO exige provedor: o fluxo de
# recuperacao de senha funciona ponta a ponta em desenvolvimento, pegando o
# link no log. Troque para `smtp` quando tiver credencial.
EMAIL_BACKEND=console
EMAIL_FROM=Legacy Doc <nao-responda@legacydoc.com.br>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Base do link de recuperacao. Em producao: https://app.legacydoc.com.br
FRONTEND_BASE_URL=http://localhost:5173

# ------------------------------------------------------------- provedores
# Configure ao menos uma. O roteador instancia so as que existirem e ajusta
# as cadeias de fallback ao que estiver disponivel.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=2

# --------------------------------------------------------------- ingestao
STORAGE_DIR=/var/legacydoc/storage
TMP_DIR=/var/legacydoc/tmp
MAX_SOURCE_FILE_BYTES=524288
MAX_REPO_FILES=2000
MAX_REPO_BYTES=262144000
CLONE_TIMEOUT_SECONDS=300

# Upload de .zip. MAX_UPLOAD_BYTES e o arquivo comprimido; o conteudo
# descomprimido e limitado por MAX_REPO_BYTES.
UPLOAD_DIR=/var/legacydoc/uploads
MAX_UPLOAD_BYTES=52428800
MAX_ARCHIVE_ENTRIES=5000

# TETO DE GASTO GLOBAL, em dolares por mes.
# Ultima linha de defesa do seu cartao: atingido este valor, NENHUM job novo
# entra ate o mes virar. Cada plano tem seu proprio teto por usuario em
# packages/core/legacydoc_core/plans.py.
# Comece baixo. Subir e uma linha; uma fatura inesperada nao volta.
GLOBAL_MONTHLY_BUDGET_USD=50

# ----------------------------------------------------------------- worker
# Slots concorrentes por processo. Para escalar, aumente aqui ou suba mais
# replicas: `docker compose up -d --scale worker=4`.
WORKER_CONCURRENCY=4
WORKER_POLL_INTERVAL_SECONDS=2
JOB_LEASE_SECONDS=900
JOB_MAX_ATTEMPTS=3
CHUNK_CONCURRENCY=6
